# ============================================
# WATSONX HACKATHON - ENVIRONMENT VARIABLES
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (which is in .gitignore)
#    Command: cp .env.example .env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit the .env file to git
# 4. NEVER share your credentials in code or with AI assistants
#
# ============================================

# IBM Cloud API Key
# Get from: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_api_key_here_DO_NOT_COMMIT


# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit
# - Your actual .env file is in .gitignore
# - Never hardcode credentials in your code
# - Use process.env.VARIABLE_NAME to access values
# - Never share credentials with AI assistants like Bob
# ============================================

# ============================================
# IBM BOB LIVE COLLAB (radar) - NON-SECRET EXAMPLE VALUES
# ============================================
# Server (radar/packages/server). Put these in wrangler.jsonc "vars".
# Secrets are NEVER stored in files: set them with `npx wrangler secret put <NAME>`
# (production) or in radar/packages/server/.dev.vars (local, git-ignored).
#   Secrets: ADMIN_SECRET, GITHUB_TOKEN
WORKSPACE_ID=toko-demo
GITHUB_REPO=<owner>/toko-demo
GITHUB_COMMIT=false
RECORD_TERMINALS=false
BOB_COAUTHOR=IBM Bob <bob@ibm.com>
AUTO_APPLY_QUEUE=true
HEARTBEAT_EXPIRE_MS=300000
CORS_ORIGIN=https://ibm-bob-live-collab.pages.dev,http://localhost:3000
PUBLIC_EXPORT=false
LOG_LEVEL=info

# Web (radar/packages/web, Cloudflare Pages)
NEXT_PUBLIC_RADAR_SERVER=https://live-collab.<account>.workers.dev
NEXT_PUBLIC_REPO_URL=https://github.com/umarmuhdhor/IBM
NEXT_PUBLIC_VIDEO_URL=
NEXT_PUBLIC_SESSIONS_URL=https://github.com/umarmuhdhor/IBM/tree/main/bob_sessions

# Client overrides for tests (sync, hooks, radar-mcp). Normally read from .radar/local.json.
# RADAR_SERVER=http://localhost:8787
# RADAR_MEMBER=A
# RADAR_ROLE=coder
# RADAR_ROOT=.
