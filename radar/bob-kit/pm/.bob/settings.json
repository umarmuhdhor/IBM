{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node .bob/hooks/brief.js start", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node .bob/hooks/brief.js prompt", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node .bob/hooks/stop.js", "timeout": 3 }] }
    ]
  }
}
