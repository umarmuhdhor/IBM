{
  // Worker + Durable Object for IBM Bob Live Collab (R1, R5 §5).
  // The WorkspaceDO binding and SQLite migration are added in fase 03.
  // Secrets (ADMIN_SECRET, GITHUB_TOKEN) are never stored here:
  // `npx wrangler secret put <NAME>` in production, `.dev.vars` (git-ignored) locally.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "live-collab",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "WORKSPACE_ID": "toko-demo",
    "GITHUB_COMMIT": "false",
    "LOG_LEVEL": "info",
  },
}
