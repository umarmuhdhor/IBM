{
  // Worker + Durable Object for IBM Bob Live Collab (R1, R5 §5, fase 03).
  // Secrets (ADMIN_SECRET, GITHUB_TOKEN) are never stored here:
  // `npx wrangler secret put <NAME>` in production, `.dev.vars` (git-ignored) locally.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "live-collab",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Bundle @radar/common from source so `wrangler dev`/`deploy` never need a prior build.
  "alias": { "@radar/common": "../common/src/index.ts" },
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "WorkspaceDO" }],
  },
  // IN-03: public/radar-cli.tgz (built by `pnpm deploy`, git-ignored) is served as a static asset before the Worker.
  "assets": { "directory": "./public" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] }],
  "vars": {
    "WORKSPACE_ID": "toko-demo",
    "CORS_ORIGIN": "*",
    "PUBLIC_EXPORT": "false",
    "BOB_COAUTHOR": "IBM Bob <bob@ibm.com>",
    "AUTO_APPLY_QUEUE": "true",
    "GITHUB_REPO": "aliefauzan/toko-demo",
    "GITHUB_COMMIT": "true",
    "LOG_LEVEL": "info",
  },
}
