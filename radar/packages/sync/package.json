{
  "name": "@radar/sync",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "radar": "./dist/radar.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepack": "pnpm run build && node scripts/kit.mjs copy",
    "postpack": "node scripts/kit.mjs clean"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^15.0.0",
    "ignore": "^7.0.10",
    "picocolors": "^1.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@radar/common": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.140.0"
  },
  "files": [
    "dist/radar.mjs",
    "bob-kit"
  ]
}
